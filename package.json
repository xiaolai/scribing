{
  "name": "@lixiaolai/scribing",
  "version": "4.0.0",
  "author": "xiaolai <lixiaolai@gmail.com>",
  "description": "Multilingual stroke models, real-font animation, tracing and copying.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaolai/scribing.git"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "keywords": [
    "handwriting",
    "stroke-order",
    "animation",
    "chinese",
    "hanzi",
    "kanji",
    "hangul",
    "font",
    "svg",
    "canvas"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.cjs.js"
    },
    "./extras/fonts/*.mjs": "./extras/fonts/*.mjs",
    "./extras/fonts/vendor/*": "./extras/fonts/vendor/*",
    "./dist/scribing.js": "./dist/scribing.js",
    "./dist/scribing.min.js": "./dist/scribing.min.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@sinonjs/fake-timers": "^15.4.0",
    "@types/jest": "^30.0.0",
    "@types/nise": "^1.4.5",
    "eslint": "^10.10.0",
    "fflate": "0.8.2",
    "globals": "^17.12.0",
    "hanzi-writer-data": "2.0.1",
    "harfbuzzjs": "1.6.1",
    "jest": "^30.5.1",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.5.1",
    "jest-fetch-mock": "^3.0.3",
    "jsdom": "^30.0.1",
    "nise": "^6.1.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-license": "^3.7.1",
    "saxes": "6.0.0",
    "svgpath": "2.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "scripts": {
    "test": "jest",
    "lint-test": "eslint",
    "lint-fix": "eslint --fix",
    "build": "rm -rf dist && rollup -c && node scripts/fonts/stamp-demo.cjs",
    "prepublishOnly": "npm run fetch-fonts && npm run build && npm run check-package",
    "prettier": "prettier -w .",
    "prettier-check": "prettier -c .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.build.json --noEmit",
    "check-package": "node scripts/check-package.cjs",
    "check-publish": "npm publish --dry-run",
    "check-demo": "node scripts/check-demo.cjs",
    "test-data": "node --test scripts/data/test/*.test.mjs",
    "check-data": "node scripts/data/check.mjs",
    "build-data": "node scripts/data/build.mjs",
    "check-data-reproducible": "node scripts/data/reproduce.mjs",
    "check-multilingual-demo": "node scripts/check-multilingual-demo.cjs",
    "fetch-fonts": "node scripts/fonts/fetch-assets.mjs --download",
    "check-fonts": "node scripts/fonts/check-assets.mjs",
    "test-fonts": "node --test scripts/fonts/provider.test.mjs scripts/fonts/skeleton.test.mjs scripts/fonts/source-loader.test.mjs scripts/fonts/junction.test.mjs scripts/fonts/progress.test.mjs scripts/fonts/animation.test.mjs",
    "check-font-demo": "node scripts/check-font-demo.cjs",
    "check-font-animation": "node scripts/check-font-animation.cjs",
    "check-font-contours": "node scripts/fonts/check-contours.cjs && node scripts/fonts/check-endpoints.cjs",
    "check-font-sources": "node scripts/check-font-sources.cjs",
    "serve-demo": "node scripts/serve-demo.cjs",
    "check-font-coverage": "node scripts/fonts/check-coverage.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "COPYING.md",
    "CITATION.cff",
    "CHANGELOG.md",
    "docs/multilingual.md",
    "docs/fonts.md",
    "extras/fonts"
  ],
  "dependencies": {},
  "homepage": "https://github.com/xiaolai/scribing",
  "bugs": {
    "url": "https://github.com/xiaolai/scribing/issues"
  }
}
