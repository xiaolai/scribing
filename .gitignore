work/

# Font binaries only: ~169 MB of unchanged upstream Noto files, deliberately kept
# out of git history. Restore them with `yarn fetch-fonts`, which verifies every
# byte length and SHA-256 against fonts/assets.lock.json before writing.
# Everything else under fonts/ is tracked: the lockfiles, catalogs, Unicode data,
# licence notices and the motor inventories.
fonts/assets/
